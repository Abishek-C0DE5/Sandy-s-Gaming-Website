# Supabase Public Keys (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Server Key (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application Settings
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional Email Provider (for Guest Contact Inquiries replies)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_api_key_here
EMAIL_FROM_ADDRESS=support@yourdomain.com
EMAIL_FROM_NAME="Customer Support Team"

# Authentication Channels ('email' | 'sms' | 'both')
NEXT_PUBLIC_AUTH_OTP_CHANNEL=email
